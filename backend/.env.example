PROJECT_NAME="AI Interview Platform"
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_interview_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_interview_db
# Sync DB URL for Alembic if needed:
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_interview_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
